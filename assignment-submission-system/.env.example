# Copy to .env before running "docker compose up --build".
# These are development defaults only; never commit real credentials.

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_DB=assignment_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- API --------------------------------------------------------------------
# HMAC-SHA256 signing key for the JWT. Must be at least 32 characters.
# Generate one with:  openssl rand -base64 48
JWT_KEY=replace-with-a-long-random-string-at-least-32-characters

# Origin allowed by CORS (the frontend).
FRONTEND_ORIGIN=http://localhost:3000

# --- Frontend ---------------------------------------------------------------
# Where the browser reaches the API. Baked into the client bundle at build time.
NEXT_PUBLIC_API_BASE_URL=http://localhost:5080
